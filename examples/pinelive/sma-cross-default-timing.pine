//@version=6
// Baseline forward-testing strategy with Pine's DEFAULT order timing.
//
// `process_orders_on_close` is not set, so it defaults to false. A market order
// created by this bar's body is filled by piner's broker emulator at the NEXT
// bar's OPEN. Pinelive only reads `strategy.position_size` after the tick, so it
// observes the new position one bar late and then corrects at that later bar's
// CLOSE price.
//
// Pair this with sma-cross-aligned-timing.pine, which is identical except for
// process_orders_on_close=true, and diff the two ledgers.
strategy("SMA cross (default order timing)",
     overlay = true,
     initial_capital = 10000,
     default_qty_type = strategy.percent_of_equity,
     default_qty_value = 50)

fastLength = input.int(10, "fast", minval = 1)
slowLength = input.int(30, "slow", minval = 2)

fast = ta.sma(close, fastLength)
slow = ta.sma(close, slowLength)

if ta.crossover(fast, slow)
    strategy.entry("long", strategy.long)
if ta.crossunder(fast, slow)
    strategy.close("long")

plot(fast, "fast", color = color.teal)
plot(slow, "slow", color = color.orange)
