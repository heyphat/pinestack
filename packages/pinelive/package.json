{
  "name": "@heyphat/pinelive",
  "version": "0.9.1",
  "description": "Forward runner and broker protocol for mirroring piner strategy positions into paper accounts or Tiger through the official OpenAPI SDK.",
  "type": "module",
  "license": "AGPL-3.0-only",
  "author": "Phat Huynh (heyphat)",
  "homepage": "https://github.com/heyphat/pinestack/tree/main/packages/pinelive#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/heyphat/pinestack.git",
    "directory": "packages/pinelive"
  },
  "bugs": {
    "url": "https://github.com/heyphat/pinestack/issues"
  },
  "keywords": [
    "pine-script",
    "piner",
    "forward-testing",
    "paper-trading",
    "broker",
    "trading"
  ],
  "bin": {
    "pinelive": "./src/cli.ts"
  },
  "scripts": {
    "build:bin": "bun ../../scripts/build-bin.ts"
  },
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./node": {
      "types": "./src/node.ts",
      "default": "./src/node.ts"
    },
    "./config": {
      "types": "./src/core/config.ts",
      "default": "./src/core/config.ts"
    },
    "./intrabar": {
      "types": "./src/intrabar.ts",
      "default": "./src/intrabar.ts"
    },
    "./testing": {
      "types": "./src/testing/index.ts",
      "default": "./src/testing/index.ts"
    }
  },
  "dependencies": {
    "@heyphat/pinery": "workspace:*",
    "@heyphat/pinerun": "workspace:*",
    "@tigeropenapi/tigeropen": "0.5.4"
  },
  "peerDependencies": {
    "@heyphat/piner": "*"
  },
  "engines": {
    "bun": ">=1.1"
  }
}
