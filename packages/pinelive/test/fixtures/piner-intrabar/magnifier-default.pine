//@version=6
strategy("magnifier default continuation", use_bar_magnifier=true, calc_on_every_tick=true, default_qty_type=strategy.fixed, default_qty_value=1)
if bar_index == 1 and strategy.position_size == 0
    strategy.entry("L", strategy.long)
if close < 90 and strategy.position_size > 0
    strategy.close("L")
plot(strategy.position_size, "position")
